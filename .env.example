# URL publique du site maison, sans slash final.
NEXT_PUBLIC_SITE_URL=http://localhost:3010

# Production / conteneur : laisser l'hébergeur définir PORT.
# Forcer l'écoute sur toutes les interfaces (Docker pose parfois HOSTNAME=id du conteneur).
# HOSTNAME=0.0.0.0
# PORT=3000


# Secret IdP comptes Omnaworks (≥ 32 caractères). Obligatoire pour register/login/SSO.
OW_AUTH_SECRET=

# Clients SSO (optionnel en local : secrets dérivés de OW_AUTH_SECRET si absents).
# OW_SSO_VIDEOVA_SECRET=
# OW_SSO_VIDEOVA_REDIRECTS=http://localhost:3000/api/auth/callback
# OW_SSO_AUDIOVA_SECRET=
# OW_SSO_AUDIOVA_REDIRECTS=http://localhost:3001/api/auth/callback
# OW_SSO_MERE_SECRET=
# OW_SSO_MERE_REDIRECTS=http://localhost:3010/compte
